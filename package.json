{
  "name": "@0xcap/loot-table",
  "version": "2.0.0",
  "description": "A simple loot table implementation in TypeScript.",
  "private": false,
  "license": "MIT",
  "author": "Andrea Cappuccio <hood@null.net>",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xCAP/loot-table.git"
  },
  "keywords": [
    "loot",
    "table",
    "random",
    "drops"
  ],
  "type": "module",
  "main": "./dist/loot-table.cjs",
  "module": "./dist/loot-table.js",
  "types": "./dist/loot-table.d.ts",
  "exports": {
    ".": {
      "types": "./dist/loot-table.d.ts",
      "import": "./dist/loot-table.js",
      "require": "./dist/loot-table.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "release": "pnpm publish --access public"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@12.11.2"
}
